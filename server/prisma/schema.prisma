generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())

  accounts     Account[]
  transactions Transaction[]

  @@map("User")
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@map("Account")
}

model Category {
  id     String        @id @default(uuid())
  name   String
  type   String // income | expense

  transactions Transaction[]
  budgets      Budget[]

  @@map("Category")
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  type            String // income | expense
  amount          Decimal
  description     String?
  date            DateTime @default(now())
  sourceInvoiceId String?  // scalar link to Invoicing's Invoice.id (same physical DB, no cross-schema relation)
  createdAt       DateTime @default(now())

  @@map("Transaction")
}

// Read-mirror of Invoicing's Invoice table — same physical table (@@map matches),
// used only so Finance can query/display invoice data without calling the Invoicing API.
// Do NOT write to this model from Finance's code.
model Invoice {
  id         String   @id
  invoiceNo  String   @unique
  customerId String
  status     String
  total      Decimal
  dueDate    DateTime
  issueDate  DateTime

  @@map("Invoice")
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Decimal
  month      Int
  year       Int

  @@map("Budget")
}